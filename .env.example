# Copy to apps/api/.env for local development. Never commit a real .env (SEC §13).
# Start a local database with `pnpm db:up`; it prints these URLs.

# The API connects as app_runtime. The startup role check refuses the owner or any role with BYPASSRLS.
DATABASE_URL=postgres://app_runtime:app-runtime-dev-only@127.0.0.1:54329/sentryops
CELL_REGION=local
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
