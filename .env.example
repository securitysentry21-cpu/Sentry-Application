# Copy to apps/api/.env for local development. Never commit a real .env (SEC §13).
# Start a local database with `pnpm db:up`; it prints these URLs.

# The API connects as app_runtime. The startup role check refuses the owner or any role with BYPASSRLS.
DATABASE_URL=postgres://app_runtime:app-runtime-dev-only@127.0.0.1:54329/sentryops
# The worker's cross-organization sweep reads due work as system_worker (`pnpm worker:dev`).
SWEEP_DATABASE_URL=postgres://system_worker:system-worker-dev-only@127.0.0.1:54329/sentryops
CELL_REGION=local
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Development sign-in by email, without an identity provider. The API refuses it in production.
DEV_AUTH=true
PUBLIC_ORIGIN=http://127.0.0.1:3000
