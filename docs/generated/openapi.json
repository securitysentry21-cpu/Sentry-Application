{
  "openapi": "3.1.0",
  "info": {
    "title": "SENTRY API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "The process is alive.",
        "x-policy": {
          "access": {
            "kind": "public"
          },
          "ownership": "none",
          "rateLimit": "none",
          "audit": null
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "summary": "The API can serve requests: the database answers and the schema is current.",
        "x-policy": {
          "access": {
            "kind": "public"
          },
          "ownership": "none",
          "rateLimit": "none",
          "audit": null
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ready"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "VALIDATION_FAILED",
                            "UNAUTHENTICATED",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "ORG_CONTEXT_REQUIRED",
                            "ORG_SUSPENDED",
                            "VERSION_CONFLICT",
                            "SHIFT_INVALID_TRANSITION",
                            "SHIFT_OVERLAP",
                            "SHIFT_NOT_ACTIVE",
                            "SHIFT_OUTSIDE_START_WINDOW",
                            "TRACKING_PERMISSION_REQUIRED",
                            "LOCATION_FIX_REQUIRED",
                            "STARTED_OFF_SITE_BLOCKED",
                            "OUTSIDE_SHIFT_WINDOW",
                            "TIMESTAMP_TOO_OLD",
                            "DEVICE_NOT_REGISTERED",
                            "DEVICE_REVOKED",
                            "INVALID_QR",
                            "LAST_OWNER",
                            "SELF_ROLE_CHANGE",
                            "INVITATION_EXPIRED",
                            "ENROLLMENT_CODE_INVALID",
                            "ATTACHMENT_TOO_LARGE",
                            "ATTACHMENT_TYPE_NOT_ALLOWED",
                            "EXPORT_RANGE_TOO_LARGE",
                            "APP_VERSION_UNSUPPORTED",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR",
                            "NOT_READY"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "issue": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "issue"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "requestId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "ORG_CONTEXT_REQUIRED",
                  "ORG_SUSPENDED",
                  "VERSION_CONFLICT",
                  "SHIFT_INVALID_TRANSITION",
                  "SHIFT_OVERLAP",
                  "SHIFT_NOT_ACTIVE",
                  "SHIFT_OUTSIDE_START_WINDOW",
                  "TRACKING_PERMISSION_REQUIRED",
                  "LOCATION_FIX_REQUIRED",
                  "STARTED_OFF_SITE_BLOCKED",
                  "OUTSIDE_SHIFT_WINDOW",
                  "TIMESTAMP_TOO_OLD",
                  "DEVICE_NOT_REGISTERED",
                  "DEVICE_REVOKED",
                  "INVALID_QR",
                  "LAST_OWNER",
                  "SELF_ROLE_CHANGE",
                  "INVITATION_EXPIRED",
                  "ENROLLMENT_CODE_INVALID",
                  "ATTACHMENT_TOO_LARGE",
                  "ATTACHMENT_TYPE_NOT_ALLOWED",
                  "EXPORT_RANGE_TOO_LARGE",
                  "APP_VERSION_UNSUPPORTED",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "NOT_READY"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "issue": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "issue"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
